= Glossar

#table(
  columns: (28%, 72%),
  table.header([*Begriff*], [*Bedeutung im Projekt*]),
  [App Router], [Dateisystembasiertes Routing von Next.js für Seiten, Layouts und serverseitige Endpunkte],
  [Client Component], [React-Komponente, die für Browserzustand oder Interaktionen clientseitig ausgeführt wird],
  [CRUD], [Erstellen, Lesen, Ändern und Löschen einer Ressource],
  [Docker Compose], [Beschreibung und gemeinsamer Start der Container `app` und `db` samt Netzwerk, Konfiguration und Volume],
  [Modularer Monolith], [Eine gemeinsam ausgelieferte Anwendung, deren fachliche Verantwortlichkeiten intern in klar abgegrenzte Module gegliedert sind],
  [MoSCoW], [Priorisierung in Must, Should, Could und Won't],
  [Route Handler], [Serverseitiger HTTP-Endpunkt innerhalb des Next.js App Routers],
  [Server Component], [Standardmässig serverseitig gerenderte React-Komponente, zum Beispiel für Navigation, Footer oder datenlesende Seiten],
  [Server Action], [Serverseitig ausgeführte Next.js-Funktion, die von der Benutzeroberfläche aus aufgerufen werden kann],
)
