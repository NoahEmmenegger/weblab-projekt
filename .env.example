# Copy this file to .env and replace the development password before deployment.
WEB_PORT=3000
# Comma-separated browser hosts for Next.js Server Actions behind a reverse proxy.
# Use the domain without https:// (for example: app.example.com).
SERVER_ACTION_ALLOWED_ORIGINS=
POSTGRES_PORT=5432
POSTGRES_DB=wohnungsvergabe
POSTGRES_USER=wohnungsvergabe
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Used by Drizzle and `npm run dev` when PostgreSQL is started through `npm run devDB`.
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:$POSTGRES_PORT/$POSTGRES_DB
